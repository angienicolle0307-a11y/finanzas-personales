rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'email',
        'displayName',
        'monthlyBudget',
        'hasCompletedOnboarding',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'email',
        'displayName',
        'monthlyBudget',
        'hasCompletedOnboarding',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string &&
      data.uid == request.auth.uid &&
      data.uid == userId &&
      isValidId(data.uid) &&
      data.email is string &&
      data.email.size() <= 254 &&
      data.displayName is string &&
      data.displayName.size() <= 100 &&
      (data.monthlyBudget is int || data.monthlyBudget is float) &&
      data.monthlyBudget >= 0 &&
      data.monthlyBudget <= 1000000000000 &&
      data.hasCompletedOnboarding is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidMovement(data, userId, movementId) {
      return data.keys().hasAll([
        'id',
        'userId',
        'amount',
        'category',
        'description',
        'date',
        'isoDate',
        'dayOfMonth',
        'icon',
        'type',
        'createdAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'userId',
        'amount',
        'category',
        'description',
        'date',
        'isoDate',
        'dayOfMonth',
        'icon',
        'type',
        'paymentMethod',
        'observations',
        'createdAt'
      ]) &&
      data.id is string &&
      data.id == movementId &&
      isValidId(data.id) &&
      data.userId is string &&
      data.userId == request.auth.uid &&
      data.userId == userId &&
      isValidId(data.userId) &&
      (data.amount is int || data.amount is float) &&
      data.amount > 0 &&
      data.amount <= 1000000000000 &&
      data.category is string &&
      data.category.size() >= 1 &&
      data.category.size() <= 60 &&
      data.description is string &&
      data.description.size() >= 1 &&
      data.description.size() <= 200 &&
      data.date is string &&
      data.date.size() >= 1 &&
      data.date.size() <= 60 &&
      data.isoDate is string &&
      data.isoDate.size() >= 10 &&
      data.isoDate.size() <= 20 &&
      data.isoDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
      data.dayOfMonth is int &&
      data.dayOfMonth >= 1 &&
      data.dayOfMonth <= 31 &&
      data.icon is string &&
      data.icon.size() >= 1 &&
      data.icon.size() <= 40 &&
      data.type is string &&
      data.type in ['EXPENSE', 'INCOME'] &&
      (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 40)) &&
      (!('observations' in data) || (data.observations is string && data.observations.size() <= 500)) &&
      data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'monthlyBudget',
          'hasCompletedOnboarding',
          'displayName',
          'updatedAt'
        ]);
      allow delete: if false;

      match /movements/{movementId} {
        allow get: if isValidId(userId) &&
          isValidId(movementId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if isOwner(userId) &&
          resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId) &&
          isValidId(movementId) &&
          isOwner(userId) &&
          isValidMovement(incoming(), userId, movementId) &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) &&
          isValidId(movementId) &&
          isOwner(userId) &&
          isValidMovement(incoming(), userId, movementId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'amount',
            'category',
            'description',
            'date',
            'isoDate',
            'dayOfMonth',
            'icon',
            'paymentMethod',
            'observations'
          ]);
        allow delete: if isValidId(userId) &&
          isValidId(movementId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }
    }
  }
}
